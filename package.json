{
  "name": "ajith-abraham-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-local-papers.mjs",
    "dev": "vite",
    "prebuild": "node scripts/check-local-papers.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "publications:update": "python3 scripts/cv_to_publications.py public/Ajith-Abraham-CV.pdf src/data/publications.json",
    "publications:links": "node scripts/enrich-publications.mjs",
    "publications:citations": "node scripts/fetch-citations.mjs",
    "journals:build": "node scripts/build-journals.mjs",
    "network:build": "node scripts/build-network.mjs",
    "papers:check": "node scripts/check-local-papers.mjs",
    "test:scripts": "node --test scripts/lib/journals.test.mjs scripts/lib/args.test.mjs scripts/lib/links.test.mjs scripts/lib/papers.test.mjs scripts/lib/citations.test.mjs"
  },
  "dependencies": {
    "framer-motion": "^14.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}